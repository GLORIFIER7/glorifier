{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://glorifier-artificial-intelligence-production.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://glorifier-artificial-intelligence-production.up.railway.app/auth/:path*"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://glorifier-artificial-intelligence-production.up.railway.app"
  }
}
