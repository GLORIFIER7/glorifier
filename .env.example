# AI providers (server-side only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# Optional OpenAI-compatible provider (e.g. Meta-hosted endpoint)
META_API_KEY=""
META_BASE_URL=""
META_MODEL=""

# App
APP_URL="http://localhost:3000"

# Public identity (server-side only; never expose the email to the browser)
GLORIFIER_GRAVATAR_EMAIL=""
GLORIFIER_NPM_PROFILE="https://www.npmjs.com/~glorifier"

# Alpaca (read-only asset sync; keep credentials server-side)
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
# Defaults to paper trading API; set only when intentionally using another authorized endpoint.
ALPACA_BROKER_BASE_URL="https://paper-api.alpaca.markets"

# PostgreSQL / Neon
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
DB_POOL_MAX="5"

# PayPal checkout (server-side only)
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Revenue verification/admin
REVENUE_WEBHOOK_SECRET=""
REVENUE_ADMIN_KEY=""
REVENUE_REQUIRED="false"

# Global intelligence pipeline (optional protection for scheduled refreshes)
INTELLIGENCE_INGEST_KEY=""

# ISO API integration (authorized ISO API access only)
ISO_API_BASE_URL="https://api-portal.iso.org"
ISO_API_KEY=""
ISO_ACCOUNT_REF=""

# Standardization Identity Federation (OIDC/federated identity)
SIF_ISSUER_URL=""
SIF_CLIENT_ID=""
SIF_REDIRECT_URI=""
SIF_ACCOUNT_REF=""
