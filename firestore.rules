rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // User monetization policies subcollection
      match /policies/{policyId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(policyId);
      }

      // User active data grants subcollection
      match /grants/{grantId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(grantId);
      }

      // User telemetry subcollection
      match /telemetry/{telemetryId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(telemetryId);
      }

      // Buyer offers subcollection
      match /offers/{offerId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(offerId);
      }
    }
  }
}
